---
import PageLayout from '@/layouts/PageLayout.astro';
import { Section } from '@/components/ui/Section';
import { Container } from '@/components/ui/Container';
import { Heading } from '@/components/ui/Heading';
import { Paragraph } from '@/components/ui/Paragraph';
import { Card } from '@/components/ui/Card';
import { Hero } from '@/components/hero/Hero';
import { 
  experience, 
  experienceSection, 
  journey, 
  journeySection, 
  projects, 
  projectsSection, 
  tech, 
  techSection, 
  practices, 
  practicesSection 
} from '@/content';
---

<PageLayout>
  
  {/* HERO SECTION */}
  <Hero />

  {/* PROFESSIONAL EXPERIENCE SECTION */}
  <Section id="experience" className="bg-surface/30 border-y border-border/40 py-24 md:py-32">
    <Container>
      <Heading as="h2" size="4xl" className="mb-6 tracking-tight">{experienceSection.title}</Heading>
      <Paragraph size="lg" muted className="mb-20 max-w-3xl leading-relaxed">
        {experienceSection.description}
      </Paragraph>

      <div class="flex flex-col gap-32">
        
        {/* TIMELINE LAYOUT: Engineering Journey */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{journeySection.title}</Heading>
          <div class="relative pl-8 md:pl-0 border-l border-border/50 md:border-none">
            {/* Desktop Timeline Line */}
            <div class="hidden md:block absolute top-0 bottom-0 left-[11.5rem] w-px bg-border/50" />

            {journey.map((phase) => (
              <div class="mb-12 md:flex last:mb-0 relative group">
                
                {/* Left Side: Title */}
                <div class="md:w-[11.5rem] flex-shrink-0 pt-2 md:pr-8 relative">
                  {/* Mobile Dot */}
                  <div class="md:hidden absolute top-3.5 -left-[37px] w-2 h-2 bg-accent rounded-full ring-4 ring-background" />
                  
                  <span class="text-sm font-semibold text-muted block md:text-right">{phase.title}</span>
                </div>

                {/* Desktop Dot */}
                <div class="hidden md:block absolute top-3.5 left-[11.5rem] w-2.5 h-2.5 bg-accent rounded-full -translate-x-1/2 ring-4 ring-background z-10 transition-transform group-hover:scale-125" />

                {/* Right Side: Content */}
                <div class="md:pl-8 flex-1 mt-4 md:mt-0">
                  <Card className="p-6 md:p-8">
                    <Paragraph className="text-primary leading-relaxed mb-6">
                      {phase.description}
                    </Paragraph>
                    {phase.milestones.length > 0 && (
                      <div class="space-y-4">
                        {phase.milestones.map(m => (
                          <div class="pl-4 border-l-2 border-border/50 group-hover:border-accent/50 transition-colors">
                            <h4 class="text-sm font-semibold text-primary mb-1">{m.title}</h4>
                            <Paragraph size="sm" muted>{m.description}</Paragraph>
                          </div>
                        ))}
                      </div>
                    )}
                  </Card>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-10">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.platformEvolutionHeading}</Heading>
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-surface to-background border border-border/50 p-1">
            <div class="absolute inset-0 bg-grid-white/[0.02] bg-[size:20px_20px]" />
            <div class="relative bg-background/40 backdrop-blur-sm rounded-xl p-8 md:p-12 min-h-[400px] flex items-center justify-center border border-white/[0.05]">
              <div class="text-center text-muted">
                <pre class="font-mono text-sm leading-[1.8] text-left inline-block text-primary/80">{experienceSection.platformEvolutionPlaceholder}</pre>
              </div>
            </div>
          </div>
        </div>

        {/* PROFESSIONAL EXPERIENCE CARDS: Product Engineering */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.productEngineeringHeading}</Heading>
          <div class="grid gap-8 md:grid-cols-2">
            {experience.filter(e => e.category === 'Product Engineering').map((item) => (
              <Card hoverable className="p-6 md:p-8 flex flex-col h-full">
                <div class="flex justify-between items-start mb-6 gap-4">
                  <Heading as="h4" size="xl">{item.title}</Heading>
                  <span class="text-xs font-medium px-2.5 py-1 bg-surface rounded-full text-muted border border-border/50 whitespace-nowrap">
                    {item.dateRange}
                  </span>
                </div>
                <div class="mb-6">
                  <span class="text-sm font-medium text-accent">{item.role}</span>
                </div>
                <Paragraph className="mb-8 flex-1 text-muted leading-relaxed">
                  {item.description}
                </Paragraph>
                <div class="flex flex-col gap-6 mt-auto">
                  <div class="flex flex-wrap gap-2">
                    {item.technologies.map(tech => (
                      <span class="text-xs px-2.5 py-1 bg-surface border border-border/50 rounded-md text-muted/90">
                        {tech}
                      </span>
                    ))}
                  </div>
                  <a href={`/projects/${item.id}`} class="text-sm font-semibold text-primary hover:text-accent transition-colors flex items-center gap-1 group/link w-fit">
                    Explore Project 
                    <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </Card>
            ))}
          </div>
        </div>

        {/* PROJECT CARD: Enterprise Consulting */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.enterpriseConsultingHeading}</Heading>
          {experience.filter(e => e.category === 'Enterprise Consulting').map((item) => (
            <Card hoverable className="p-8 md:p-10 flex flex-col md:flex-row gap-8 items-center">
              <div class="flex-1 w-full space-y-6">
                <div>
                  <Heading as="h4" size="xl" className="mb-2">{item.title}</Heading>
                  <span class="text-sm font-medium text-accent">{item.role}</span>
                </div>
                <Paragraph className="leading-relaxed text-muted">
                  {item.description}
                </Paragraph>
                <div class="flex flex-col gap-6">
                  <div class="flex flex-wrap gap-2">
                    {item.technologies.map(tech => (
                      <span class="text-xs px-2.5 py-1 bg-surface border border-border/50 rounded-md text-muted/90">
                        {tech}
                      </span>
                    ))}
                  </div>
                  <a href={`/projects/${item.id}`} class="text-sm font-semibold text-primary hover:text-accent transition-colors flex items-center gap-1 group/link w-fit">
                    Explore Project 
                    <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </div>
              <div class="hidden md:flex w-full md:w-1/3 h-48 bg-surface/50 border border-border/50 rounded-lg items-center justify-center flex-shrink-0">
                <span class="text-4xl opacity-50">🏢</span>
              </div>
            </Card>
          ))}
        </div>

        {/* INTERNAL TOOL CARDS: Internal Engineering */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.internalEngineeringHeading}</Heading>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {experience.filter(e => e.category === 'Internal Engineering').map((item) => (
              <Card hoverable className="p-6">
                <div class="h-12 w-12 bg-surface border border-border/50 rounded-lg mb-6 flex items-center justify-center text-xl">
                  ⚙️
                </div>
                <Heading as="h4" size="lg" className="mb-2">{item.title}</Heading>
                <Paragraph size="sm" className="mb-4 text-accent">{item.role}</Paragraph>
                <Paragraph size="sm" muted>
                  {item.description}
                </Paragraph>
              </Card>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>

  {/* PERSONAL PROJECTS SECTION */}
  <Section id="projects" className="py-24 md:py-32">
    <Container>
      <Heading as="h2" size="4xl" className="mb-6 tracking-tight">{projectsSection.title}</Heading>
      <Paragraph size="lg" muted className="mb-20 max-w-3xl leading-relaxed">
        {projectsSection.description}
      </Paragraph>

      <div class="grid gap-12 lg:grid-cols-2">
        {projects.map((project) => (
          <Card hoverable className="overflow-hidden flex flex-col">
            <div class="h-48 md:h-64 bg-surface/50 border-b border-border/50 w-full flex items-center justify-center text-5xl opacity-50">
              🚀
            </div>
            <div class="p-6 md:p-8 flex flex-col flex-1">
              <Heading as="h4" size="xl" className="mb-4">{project.title}</Heading>
              <Paragraph className="mb-8 flex-1 whitespace-pre-line text-muted">
                {project.description}
              </Paragraph>
              <div class="flex gap-4 mt-auto">
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:text-accent transition-colors">
                    View Project →
                  </a>
                )}
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-muted hover:text-primary transition-colors">
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  {/* TECH / ENGINEERING STACK & PRACTICES SECTION */}
  <Section id="tech" className="bg-surface/30 border-t border-border/40 py-24 md:py-32">
    <Container>
      <div class="grid gap-20 lg:grid-cols-2">
        
        {/* TECHNOLOGY GRID: Engineering Stack */}
        <div class="flex flex-col gap-10">
          <Heading as="h2" size="3xl" className="tracking-tight">{techSection.title}</Heading>
          <div class="flex flex-col gap-8">
            {tech.map((group) => (
              <div class="flex flex-col md:flex-row gap-2 md:gap-4 md:items-start border-b border-border/40 pb-6 last:border-0 last:pb-0">
                <div class="w-40 flex-shrink-0 pt-1">
                  <span class="text-sm font-medium text-primary">{group.category}</span>
                </div>
                <div class="flex flex-wrap gap-2 flex-1">
                  {group.items.map((item) => (
                    <span class="text-sm px-3 py-1 bg-surface border border-border/50 rounded-full text-muted hover:text-primary hover:border-border transition-colors">
                      {item.name}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* LIST/GRID: Engineering Practices */}
        <div class="flex flex-col gap-10">
          <Heading as="h2" size="3xl" className="tracking-tight">{practicesSection.title}</Heading>
          <div class="grid sm:grid-cols-2 gap-6">
            {practices.map((practice) => (
              <div class="flex gap-4 group">
                <div class="h-10 w-10 bg-surface border border-border/50 rounded flex items-center justify-center flex-shrink-0 group-hover:border-accent/50 transition-colors">
                  <span class="text-accent text-lg">✦</span>
                </div>
                <div class="flex flex-col gap-1 flex-1">
                  <h4 class="text-base font-semibold text-primary">{practice.title}</h4>
                  <Paragraph size="sm" muted className="leading-relaxed">
                    {practice.description}
                  </Paragraph>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>

</PageLayout>
