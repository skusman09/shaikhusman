---
import PageLayout from '@/layouts/PageLayout.astro';
import { Section } from '@/components/ui/Section';
import { Container } from '@/components/ui/Container';
import { Heading } from '@/components/ui/Heading';
import { Paragraph } from '@/components/ui/Paragraph';
import { Card } from '@/components/ui/Card';
import { Hero } from '@/components/hero/Hero';
import { 
  experience, 
  experienceSection, 
  journey, 
  journeySection, 
  projects, 
  projectsSection, 
  tech, 
  techSection, 
  practices, 
  practicesSection 
} from '@/content';
---

<PageLayout>
  
  {/* HERO SECTION */}
  <Hero />

  {/* PROFESSIONAL EXPERIENCE SECTION */}
  <Section id="experience" className="bg-surface/30 border-y border-border/40 py-24 md:py-32">
    <Container>
      <Heading as="h2" size="4xl" className="mb-6 tracking-tight">{experienceSection.title}</Heading>
      <Paragraph size="lg" muted className="mb-20 max-w-3xl leading-relaxed">
        {experienceSection.description}
      </Paragraph>

      <div class="flex flex-col gap-32">
        
        {/* TIMELINE LAYOUT: Engineering Journey */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{journeySection.title}</Heading>
          <div class="relative pl-8 md:pl-0 border-l md:border-l-0 border-border/50">
            {/* Timeline Placeholder Items */}
            {journey.map(() => (
              <div class="mb-12 md:flex md:gap-8 last:mb-0 relative">
                {/* Timeline Node */}
                <div class="absolute left-[-37px] md:static md:w-48 flex-shrink-0 pt-1">
                  <div class="h-6 w-24 bg-border/20 rounded md:ml-auto" />
                  <div class="hidden md:block absolute top-2 right-0 w-3 h-3 bg-accent rounded-full -mr-1.5 ring-4 ring-background" />
                </div>
                {/* Timeline Content */}
                <Card className="flex-1 p-6 md:p-8 relative">
                  <div class="h-8 w-3/4 bg-border/20 rounded mb-4" />
                  <div class="h-20 w-full bg-border/10 rounded" />
                </Card>
              </div>
            ))}
            {/* Timeline Line for Desktop */}
            <div class="hidden md:block absolute top-0 bottom-0 left-[192px] w-[1px] bg-border/50" />
          </div>
        </div>

        {/* ARCHITECTURE DIAGRAM CONTAINER: Platform Evolution */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.platformEvolutionHeading}</Heading>
          <Card className="p-8 md:p-12 min-h-[400px] flex items-center justify-center bg-background/50 border-dashed">
            <div class="text-center text-muted">
              <span class="block mb-4 text-4xl">🏗️</span>
              {experienceSection.platformEvolutionPlaceholder}
            </div>
          </Card>
        </div>

        {/* PROFESSIONAL EXPERIENCE CARDS: Product Engineering */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.productEngineeringHeading}</Heading>
          <div class="grid gap-8 md:grid-cols-2">
            {experience.filter(e => e.category === 'Product Engineering').map(() => (
              <Card hoverable className="p-6 md:p-8 flex flex-col h-full">
                <div class="flex justify-between items-start mb-6">
                  <div class="h-10 w-32 bg-border/20 rounded" />
                  <div class="h-6 w-20 bg-border/10 rounded-full" />
                </div>
                <div class="flex-1 space-y-4 mb-8">
                  <div class="h-4 w-full bg-border/10 rounded" />
                  <div class="h-4 w-5/6 bg-border/10 rounded" />
                  <div class="h-4 w-4/6 bg-border/10 rounded" />
                </div>
                <div class="flex gap-2 mt-auto">
                  <div class="h-6 w-16 bg-border/20 rounded" />
                  <div class="h-6 w-16 bg-border/20 rounded" />
                </div>
              </Card>
            ))}
          </div>
        </div>

        {/* PROJECT CARD: Enterprise Consulting */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.enterpriseConsultingHeading}</Heading>
          {experience.filter(e => e.category === 'Enterprise Consulting').map(() => (
            <Card hoverable className="p-8 md:p-10 flex flex-col md:flex-row gap-8 items-center">
              <div class="flex-1 w-full space-y-6">
                <div class="h-10 w-48 bg-border/20 rounded" />
                <div class="space-y-3">
                  <div class="h-4 w-full bg-border/10 rounded" />
                  <div class="h-4 w-full bg-border/10 rounded" />
                  <div class="h-4 w-2/3 bg-border/10 rounded" />
                </div>
              </div>
              <div class="w-full md:w-1/3 h-48 bg-border/20 rounded-lg flex-shrink-0" />
            </Card>
          ))}
        </div>

        {/* INTERNAL TOOL CARDS: Internal Engineering */}
        <div class="flex flex-col gap-12">
          <Heading as="h3" size="2xl" className="tracking-tight">{experienceSection.internalEngineeringHeading}</Heading>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {experience.filter(e => e.category === 'Internal Engineering').map(() => (
              <Card hoverable className="p-6">
                <div class="h-12 w-12 bg-border/20 rounded-lg mb-6" />
                <div class="h-6 w-3/4 bg-border/20 rounded mb-4" />
                <div class="h-16 w-full bg-border/10 rounded" />
              </Card>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>

  {/* PERSONAL PROJECTS SECTION */}
  <Section id="projects" className="py-24 md:py-32">
    <Container>
      <Heading as="h2" size="4xl" className="mb-6 tracking-tight">{projectsSection.title}</Heading>
      <Paragraph size="lg" muted className="mb-20 max-w-3xl leading-relaxed">
        {projectsSection.description}
      </Paragraph>

      <div class="grid gap-12 lg:grid-cols-2">
        {projects.map(() => (
          <Card hoverable className="overflow-hidden flex flex-col">
            <div class="h-64 bg-border/20 w-full" />
            <div class="p-8 flex flex-col flex-1">
              <div class="h-8 w-1/2 bg-border/20 rounded mb-4" />
              <div class="space-y-3 mb-8 flex-1">
                <div class="h-4 w-full bg-border/10 rounded" />
                <div class="h-4 w-5/6 bg-border/10 rounded" />
              </div>
              <div class="flex gap-4">
                <div class="h-8 w-24 bg-border/20 rounded" />
                <div class="h-8 w-24 bg-border/20 rounded" />
              </div>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  {/* TECH / ENGINEERING STACK & PRACTICES SECTION */}
  <Section id="tech" className="bg-surface/30 border-t border-border/40 py-24 md:py-32">
    <Container>
      <div class="grid gap-20 lg:grid-cols-2">
        
        {/* TECHNOLOGY GRID: Engineering Stack */}
        <div class="flex flex-col gap-10">
          <Heading as="h2" size="3xl" className="tracking-tight">{techSection.title}</Heading>
          <div class="flex flex-col gap-8">
            {tech.map((group) => (
              <div class="flex flex-col md:flex-row gap-4 md:items-start">
                <div class="w-40 flex-shrink-0">
                  <div class="h-6 w-24 bg-border/20 rounded" />
                </div>
                <div class="flex flex-wrap gap-2 flex-1">
                  {group.items.map(() => (
                    <div class="h-8 w-20 bg-border/10 rounded-full" />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* LIST/GRID: Engineering Practices */}
        <div class="flex flex-col gap-10">
          <Heading as="h2" size="3xl" className="tracking-tight">{practicesSection.title}</Heading>
          <div class="grid sm:grid-cols-2 gap-6">
            {practices.map(() => (
              <div class="flex items-center gap-4">
                <div class="h-10 w-10 bg-border/20 rounded flex-shrink-0" />
                <div class="flex flex-col gap-2 flex-1">
                  <div class="h-4 w-full bg-border/20 rounded" />
                  <div class="h-3 w-3/4 bg-border/10 rounded" />
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </Container>
  </Section>

</PageLayout>
